            },
            "url": {
              "path": [
                "apiflds",
                "FieldSearchRequest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Session identifier — Desktop, Server API ASID, or B-PIPE BPID",
                  "type": "any",
                  "value": "{{session}}",
                  "key": "session"
