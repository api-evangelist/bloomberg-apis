              "raw": "{\n  \"id\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"returnFieldDocumentation\": false,\n  \"properties\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}"
