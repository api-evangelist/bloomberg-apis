          "name": "Get field metadata by id (mnemonic or alpha-numeric identifier)",
          "request": {
            "name": "Get field metadata by id (mnemonic or alpha-numeric identifier)",
            "description": {
              "content": "Returns descriptive information for one or more Bloomberg fields\nspecified by mnemonic (e.g. `LAST_PRICE`) or alpha-numeric ID\n(e.g. `pq005`). Optionally returns documentation.\n\n**BLPAPI service**: `//blp/apiflds`\n**Operation**: `FieldInfoRequest`\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "apiflds",
                "FieldInfoRequest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Session identifier — Desktop, Server API ASID, or B-PIPE BPID",
                  "type": "any",
                  "value": "{{session}}",
                  "key": "session"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-blpapi-request"
              },
              {
                "key": "Accept",
                "value": "application/x-blpapi-response"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
