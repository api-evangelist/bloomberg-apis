        {
          "id": "a63e0e07-f765-4808-b76c-9189dbf99edb",
          "name": "Authorize a Bloomberg user against an IP address (Server API) or token (B-PIPE)",
          "request": {
            "name": "Authorize a Bloomberg user against an IP address (Server API) or token (B-PIPE)",
            "description": {
              "content": "Checks whether a given Bloomberg Anywhere user (UUID) is logged into\nBloomberg Professional at the specified location, and returns an\nIdentity object that subsequent requests can use to assert\npermissioning.\n\n**BLPAPI service**: `//blp/apiauth`\n**Operation**: `AuthorizationRequest`\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "apiauth",
                "AuthorizationRequest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Session identifier — Desktop, Server API ASID, or B-PIPE BPID",
                  "type": "any",
                  "value": "{{session}}",
                  "key": "session"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-blpapi-request"
              },
              {
                "key": "Accept",
                "value": "application/x-blpapi-response"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uuid\": \"<integer>\",\n  \"ipAddress\": \"<string>\",\n  \"token\": \"<string>\",\n  \"requireAsidEquivalence\": false\n}"
            }
          },
          "response": [
            {
              "id": "10098eed-ecb6-4d03-95a7-8c45ea9af68a",
              "name": "AuthorizationSuccess or AuthorizationFailure",
              "originalRequest": {
                "url": {
                  "path": [
                    "apiauth",
                    "AuthorizationRequest"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Session identifier — Desktop, Server API ASID, or B-PIPE BPID",
                      "type": "any",
                      "value": "{{session}}",
                      "key": "session"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "X-BLPAPI-Session",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/x-blpapi-response"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"uuid\": 11223344,\n  \"ipAddress\": \"111.22.33.44\",\n  \"token\": \"<string>\",\n  \"requireAsidEquivalence\": false\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/x-blpapi-response"
                }
